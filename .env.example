# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Symmetric Encryption Key for database storage (Fernet key)
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=YOUR_FERNET_SECRET_KEY_HERE

# Your personal Telegram User ID for admin commands (numeric, e.g. 123456789)
ALLOWED_USER_ID=

# Database URL (Optional: defaults to local SQLite zajel_users.db if not provided)
# For cloud PostgreSQL (e.g. Render/Supabase): postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Optional HTTP Port for cloud deployment health check (e.g. Render Web Service)
PORT=
